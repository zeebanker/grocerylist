{
  "rules": {
    "households": {
      "karkart-family": {
        ".read": "auth != null",
        ".write": "auth != null",
        "items":           { ".validate": "newData.isString() && newData.val().length <= 4000000" },
        "customItems":     { ".validate": "newData.isString() && newData.val().length <= 500000" },
        "purchaseHistory": { ".validate": "newData.isString() && newData.val().length <= 4000000" },
        "itemLocations":   { ".validate": "newData.isString() && newData.val().length <= 500000" },
        "lastUpdated":     { ".validate": "newData.isNumber()" },
        "$unexpected":     { ".validate": false }
      }
    },
    "presence": {
      "karkart-family": {
        ".read": "auth != null",
        "$session": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['timestamp', 'sid'])",
          "timestamp": { ".validate": "newData.isNumber()" },
          "sid":       { ".validate": "newData.isString() && newData.val().length <= 100" },
          "storeId":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "status":    { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$unexpected": { ".validate": false }
        }
      }
    }
  }
}
